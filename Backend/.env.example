APP_NAME="GearShare API"
APP_ENV="development"
DEBUG=true
DATABASE_URL="postgresql+psycopg://postgres:your-password@db.your-supabase-project.supabase.co:5432/postgres?sslmode=require"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ADMIN_API_KEY="replace-with-a-secure-admin-api-key"

# Email Configuration (Gmail SMTP)
EMAIL_PROVIDER=gmail
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="GearShare <your_gmail@gmail.com>"
